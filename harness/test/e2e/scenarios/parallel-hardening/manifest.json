{
  "schema_version": 1,
  "name": "parallel-hardening",
  "description": "Harden a streaming upload service through parallel security and performance review while overlapping Nodes crash and recover.",
  "entry_node": "A",
  "prompt_file": "prompt.txt",
  "nodes": [
    { "id": "A", "role": "streaming upload service owner and implementer", "policy_file": "policies/A.json" },
    { "id": "B", "role": "Alpha transport member and backpressure fixture observer", "policy_file": "policies/B.json" },
    { "id": "C", "role": "consumer and backpressure contract coordinator", "policy_file": "policies/C.json" },
    { "id": "D", "role": "Beta transport member and performance fixture observer", "policy_file": "policies/D.json" },
    { "id": "E", "role": "security and performance reviewer", "policy_file": "policies/E.json" },
    { "id": "F", "role": "deployment compatibility reviewer", "policy_file": "policies/F.json" }
  ],
  "channels": [
    { "alias": "alpha", "owner": "A", "members": ["A", "B", "C"] },
    { "alias": "beta", "owner": "C", "members": ["C", "D", "E"] },
    { "alias": "gamma", "owner": "E", "members": ["E", "F", "A"] }
  ],
  "derived_path": ["A:alpha:C", "C:beta:E", "E:gamma:F", "E:beta:C", "C:alpha:A"],
  "faults": [
    {
      "id": "dual-runtime-on-c",
      "type": "concurrent-runtime",
      "phase": "c-alpha-handling-pending",
      "target": "runtime:C",
      "required_observation": "Exactly one Runtime owns the handling and the loser receives a stable busy or empty result."
    },
    {
      "id": "dual-runtime-on-e",
      "type": "concurrent-runtime",
      "phase": "e-beta-handling-pending",
      "target": "runtime:E",
      "required_observation": "Exactly one Runtime owns the handling and no duplicate Work transition is committed."
    },
    {
      "id": "restart-overlap-c",
      "type": "node-kill",
      "phase": "parallel-review-active",
      "target": "node:C",
      "required_observation": "C restores Alpha and Beta subscriptions, baselines, cursors, and pending Work without duplicate transitions."
    },
    {
      "id": "restart-overlap-e",
      "type": "node-kill",
      "phase": "parallel-review-active",
      "target": "node:E",
      "required_observation": "E restores Beta and Gamma subscriptions, baselines, cursors, and pending Work without duplicate transitions."
    },
    {
      "id": "preclaim-attachment-rename-crash",
      "type": "preclaim-file-crash",
      "phase": "before-e-runtime-launch",
      "target": "runtime:E",
      "required_observation": "A crash between attachment staging, claim, and rename never launches the wrong owner and leaves bounded recovery evidence."
    }
  ],
  "oracles": {
    "system": [
      "ND-17",
      "single-owner-per-handling-under-concurrency",
      "c-restores-alpha-and-beta-independently",
      "e-restores-beta-and-gamma-independently",
      "restart-produces-no-duplicate-transition",
      "candidate-artifact-closure-remains-work-scoped",
      "non-audience-members-only-ignored",
      "all-fresh-handlings-terminal"
    ],
    "task": [
      {
        "id": "upload-path-secret-resource-and-e2e-suite",
        "command": ["/evidence/oracle/oracle.sh"],
        "timeout_seconds": 240,
        "evidence": ["case/", "result/"]
      }
    ],
    "experience": [
      "one-natural-business-prompt-on-a",
      "zero-remote-user-prompts",
      "zero-manual-recovery-actions",
      "six-nodes-observed-in-transport-or-business-path"
    ]
  },
  "expected": {
    "business_prompts": 1,
    "remote_prompts": 0,
    "manual_daemon_actions": 0,
    "manual_sync_actions": 0,
    "nodes_in_business_path": ["A", "B", "C", "D", "E", "F"],
    "channels_ready": ["alpha", "beta", "gamma"],
    "cross_channel_bridges": 0,
    "fresh_handlings_terminal": true,
    "parallel_runtime_count": 2
  }
}
