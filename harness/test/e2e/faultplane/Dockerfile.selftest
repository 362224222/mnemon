# syntax=docker/dockerfile:1.7

ARG GO_IMAGE=golang:1.24.6-bookworm@sha256:ab1d1823abb55a9504d2e3e003b75b36dbeb1cbcc4c92593d85a84ee46becc6c

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY harness/test/e2e/faultplane/response_loss_proxy.go ./response_loss_proxy.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/r5-response-loss-proxy ./response_loss_proxy.go

FROM ${GO_IMAGE}
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl python3 tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 r5 && \
    useradd --uid 10001 --gid 10001 --create-home --home-dir /home/r5 r5 && \
    install -d -o r5 -g r5 -m 0700 /workspace
COPY --from=build /out/r5-response-loss-proxy /opt/r5/bin/r5-response-loss-proxy
RUN chmod 0755 /opt/r5/bin/r5-response-loss-proxy
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
