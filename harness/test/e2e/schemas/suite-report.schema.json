{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemon.dev/schemas/r5/suite-report.schema.json",
  "title": "Mnemon R5 five-case acceptance suite report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "bundle_kind",
    "runtime",
    "status",
    "generated_at",
    "git_sha",
    "image",
    "case_names",
    "cases",
    "paired_hermetic_run"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "bundle_kind": { "const": "suite" },
    "runtime": { "enum": ["scripted", "codex"] },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "revision", "source_tree", "codex_version", "codex_integrity"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "codex_version": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9.+-]+$" }
          ]
        },
        "codex_integrity": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
          ]
        }
      }
    },
    "case_names": { "$ref": "#/$defs/caseNames" },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/paymentCase" },
        { "$ref": "#/$defs/apiCase" },
        { "$ref": "#/$defs/offlineCase" },
        { "$ref": "#/$defs/parallelCase" },
        { "$ref": "#/$defs/overlapCase" }
      ],
      "items": false
    },
    "paired_hermetic_run": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "caseNames": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "const": "payment-review" },
        { "const": "api-sdk-contract" },
        { "const": "offline-incident" },
        { "const": "parallel-hardening" },
        { "const": "overlapping-channels" }
      ],
      "items": false
    },
    "caseBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "run_id", "status", "exit_code", "task_oracles_passed", "system_invariants_passed"],
      "properties": {
        "name": {
          "enum": [
            "payment-review",
            "api-sdk-contract",
            "offline-incident",
            "parallel-hardening",
            "overlapping-channels"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "task_oracles_passed": { "type": "boolean" },
        "system_invariants_passed": { "type": "boolean" }
      }
    },
    "paymentCase": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }, { "properties": { "name": { "const": "payment-review" } } }]
    },
    "apiCase": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }, { "properties": { "name": { "const": "api-sdk-contract" } } }]
    },
    "offlineCase": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }, { "properties": { "name": { "const": "offline-incident" } } }]
    },
    "parallelCase": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }, { "properties": { "name": { "const": "parallel-hardening" } } }]
    },
    "overlapCase": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }, { "properties": { "name": { "const": "overlapping-channels" } } }]
    }
  }
}
