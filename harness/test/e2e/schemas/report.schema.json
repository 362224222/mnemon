{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemon.dev/schemas/r5/report.schema.json",
  "title": "Mnemon R5 per-case acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario",
    "runtime",
    "status",
    "git_sha",
    "image_digest",
    "scenario_digest",
    "versions",
    "counts",
    "commands",
    "assertions",
    "faults",
    "latency",
    "oracle"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/runID" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "runtime": { "enum": ["scripted", "codex"] },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "image_digest": { "$ref": "#/$defs/digest" },
    "scenario_digest": { "$ref": "#/$defs/digest" },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "codex", "model", "reasoning_effort"],
      "properties": {
        "harness": { "type": "string", "minLength": 1, "maxLength": 256 },
        "codex": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reasoning_effort": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_prompts", "remote_prompts", "manual_daemon_actions", "manual_sync_actions", "nodes", "channels"],
      "properties": {
        "business_prompts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "remote_prompts": { "type": "integer", "minimum": 0, "maximum": 0 },
        "manual_daemon_actions": { "type": "integer", "minimum": 0, "maximum": 0 },
        "manual_sync_actions": { "type": "integer", "minimum": 0, "maximum": 0 },
        "nodes": { "type": "integer", "minimum": 0, "maximum": 6 },
        "channels": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/command" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "category", "required", "passed", "evidence", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "category": { "enum": ["system", "task", "experience"] },
          "required": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      }
    },
    "faults": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/fault" }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup_ms", "channel_join_ms", "channel_ready_ms"],
      "properties": {
        "setup_ms": { "type": "array", "maxItems": 6, "items": { "type": "integer", "minimum": 0 } },
        "channel_join_ms": { "type": "array", "maxItems": 6, "items": { "type": "integer", "minimum": 0 } },
        "channel_ready_ms": { "type": "array", "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 10000 } }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "task", "experience"],
      "properties": {
        "system": { "$ref": "#/$defs/oracleCategory" },
        "experience": { "$ref": "#/$defs/oracleCategory" },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "results"],
          "properties": {
            "passed": { "type": "boolean" },
            "results": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": ["id", "passed", "exit_code", "evidence"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "passed": { "type": "boolean" },
                  "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
                  "evidence": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "runID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "node", "kind", "started_unix_ms", "finished_unix_ms", "duration_ms", "exit_code", "evidence"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "node": { "enum": ["A", "B", "C", "D", "E", "F"] },
        "kind": { "enum": ["setup", "channel-create", "channel-join", "status", "doctor", "business-prompt"] },
        "started_unix_ms": { "type": "integer", "minimum": 1 },
        "finished_unix_ms": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "evidence": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "phase", "target", "injected", "required_observation", "observation_passed", "detail", "at"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "phase": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "injected": { "type": "boolean" },
        "required_observation": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "observation_passed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "at": { "type": "string", "format": "date-time" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "scenario": {
      "enum": [
        "payment-review",
        "api-sdk-contract",
        "offline-incident",
        "parallel-hardening",
        "overlapping-channels"
      ]
    },
    "oracleCategory": {
      "type": "object",
      "required": ["passed"],
      "properties": { "passed": { "type": "boolean" } },
      "additionalProperties": false
    }
  }
}
