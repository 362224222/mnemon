{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemon.dev/schemas/r5/network-paths.schema.json",
  "title": "Mnemon R5 public publication path evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "identity_binding", "publications", "evidence_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/runID" },
    "identity_binding": { "const": "public-d4" },
    "publications": {
      "type": "array",
      "maxItems": 384,
      "items": { "$ref": "#/$defs/publication" }
    },
    "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
  },
  "$defs": {
    "runID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identity": { "type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "node": { "enum": ["A", "B", "C", "D", "E", "F"] },
    "nullableNode": { "oneOf": [{ "$ref": "#/$defs/node" }, { "type": "null" }] },
    "nullableIdentity": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$" }
    },
    "publicationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_peer_id", "origin_epoch", "channel_sequence"],
      "properties": {
        "origin_peer_id": { "$ref": "#/$defs/identity" },
        "origin_epoch": { "$ref": "#/$defs/identity" },
        "channel_sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "eventKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_peer_id", "origin_epoch", "event_id"],
      "properties": {
        "origin_peer_id": { "$ref": "#/$defs/identity" },
        "origin_epoch": { "$ref": "#/$defs/identity" },
        "event_id": { "$ref": "#/$defs/identity" }
      }
    },
    "nullableEventKey": { "oneOf": [{ "$ref": "#/$defs/eventKey" }, { "type": "null" }] },
    "peerIDs": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identity" }
    },
    "nodes": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel", "observer_node", "observer_peer_id", "publication_ref",
        "publication_digest", "event_key", "event_digest", "channel_id_digest",
        "origin_peer_id", "origin_node", "immediate_transport_peer_id",
        "immediate_transport_node", "arrival", "audience_peer_ids", "audience_nodes",
        "ignored_peer_ids", "ignored_nodes", "semantic_outcome",
        "artifact_direct_source_peer_id", "artifact_direct_source_node",
        "causality_event_key", "evidence_refs"
      ],
      "properties": {
        "channel": { "enum": ["alpha", "beta", "gamma"] },
        "observer_node": { "$ref": "#/$defs/node" },
        "observer_peer_id": { "$ref": "#/$defs/identity" },
        "publication_ref": { "$ref": "#/$defs/publicationRef" },
        "publication_digest": { "$ref": "#/$defs/digest" },
        "event_key": { "$ref": "#/$defs/eventKey" },
        "event_digest": { "$ref": "#/$defs/digest" },
        "channel_id_digest": { "$ref": "#/$defs/digest" },
        "origin_peer_id": { "$ref": "#/$defs/identity" },
        "origin_node": { "$ref": "#/$defs/node" },
        "immediate_transport_peer_id": { "$ref": "#/$defs/identity" },
        "immediate_transport_node": { "$ref": "#/$defs/node" },
        "arrival": { "enum": ["local", "gossip", "repair"] },
        "audience_peer_ids": { "allOf": [{ "$ref": "#/$defs/peerIDs" }, { "minItems": 1 }] },
        "audience_nodes": { "allOf": [{ "$ref": "#/$defs/nodes" }, { "minItems": 1 }] },
        "ignored_peer_ids": { "allOf": [{ "$ref": "#/$defs/peerIDs" }, { "maxItems": 1 }] },
        "ignored_nodes": { "allOf": [{ "$ref": "#/$defs/nodes" }, { "maxItems": 1 }] },
        "semantic_outcome": {
          "enum": [
            "originated", "stored", "waiting_artifact", "ready", "processing",
            "accepted", "rejected", "conflicted", "retry", "quarantined", "ignored"
          ]
        },
        "artifact_direct_source_peer_id": { "$ref": "#/$defs/nullableIdentity" },
        "artifact_direct_source_node": { "$ref": "#/$defs/nullableNode" },
        "causality_event_key": { "$ref": "#/$defs/nullableEventKey" },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      },
      "allOf": [
        {
          "if": { "properties": { "arrival": { "const": "local" } }, "required": ["arrival"] },
          "then": {
            "properties": {
              "semantic_outcome": { "const": "originated" },
              "artifact_direct_source_peer_id": { "type": "null" },
              "artifact_direct_source_node": { "type": "null" },
              "ignored_peer_ids": { "maxItems": 0 },
              "ignored_nodes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "arrival": { "const": "repair" } }, "required": ["arrival"] },
          "then": {
            "properties": {
              "immediate_transport_peer_id": { "$ref": "#/$defs/identity" }
            }
          }
        }
      ]
    }
  }
}
