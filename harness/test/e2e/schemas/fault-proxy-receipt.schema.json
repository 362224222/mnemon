{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemon.dev/schemas/r5/fault-proxy-receipt.schema.json",
  "title": "Mnemon R5 one-shot response-loss proxy receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token",
    "outcome",
    "started_at",
    "accepted_at",
    "first_response_byte_at",
    "finished_at",
    "request_bytes_forwarded",
    "response_bytes_forwarded",
    "first_response_byte_observed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "token": { "$ref": "#/$defs/token" },
    "outcome": { "const": "response_dropped_after_first_byte" },
    "started_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": "string", "format": "date-time" },
    "first_response_byte_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "request_bytes_forwarded": { "type": "integer", "minimum": 1 },
    "response_bytes_forwarded": { "const": 0 },
    "first_response_byte_observed": { "const": true }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
