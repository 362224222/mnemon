{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemon.dev/schemas/r5/fault-action.schema.json",
  "title": "Mnemon R5 supervised external fault action",
  "oneOf": [
    { "$ref": "#/$defs/responseLoss" },
    { "$ref": "#/$defs/edgeBlock" },
    { "$ref": "#/$defs/nodeDisconnect" },
    { "$ref": "#/$defs/nodeRestart" }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "containerID": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "networkID": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "networkName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
    "responseLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "token", "action", "external_action_applied",
        "public_observation_bound", "client_exit_code", "client_stdout_bytes",
        "client_stderr_bytes", "response_first_byte_observed",
        "response_bytes_forwarded_to_client", "socket_restored", "proxy_receipt",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "token": { "$ref": "#/$defs/token" },
        "action": { "const": "unix-response-loss" },
        "external_action_applied": { "const": true },
        "public_observation_bound": { "const": false },
        "client_exit_code": { "$ref": "#/$defs/exitCode" },
        "client_stdout_bytes": { "type": "integer", "minimum": 0 },
        "client_stderr_bytes": { "type": "integer", "minimum": 0 },
        "response_first_byte_observed": { "const": true },
        "response_bytes_forwarded_to_client": { "const": 0 },
        "socket_restored": { "const": true },
        "proxy_receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-proxy\\.json$"
        },
        "generated_at": { "$ref": "#/$defs/generatedAt" }
      }
    },
    "edgeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "token", "action", "external_action_applied",
        "public_observation_bound", "restored", "network_id", "network_name",
        "left_container_id", "right_container_id", "left_ipv4", "right_ipv4",
        "nft_table", "command_exit_code", "generated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "token": { "$ref": "#/$defs/token" },
        "action": { "const": "docker-edge-block" },
        "external_action_applied": { "const": true },
        "public_observation_bound": { "const": false },
        "restored": { "const": true },
        "network_id": { "$ref": "#/$defs/networkID" },
        "network_name": { "$ref": "#/$defs/networkName" },
        "left_container_id": { "$ref": "#/$defs/containerID" },
        "right_container_id": { "$ref": "#/$defs/containerID" },
        "left_ipv4": { "type": "string", "format": "ipv4" },
        "right_ipv4": { "type": "string", "format": "ipv4" },
        "nft_table": { "type": "string", "pattern": "^R5E[a-f0-9]{16}$" },
        "command_exit_code": { "$ref": "#/$defs/exitCode" },
        "generated_at": { "$ref": "#/$defs/generatedAt" }
      }
    },
    "nodeDisconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "token", "action", "external_action_applied",
        "public_observation_bound", "restored", "network_id", "network_name",
        "container_id", "restored_ipv4", "restored_aliases", "command_exit_code",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "token": { "$ref": "#/$defs/token" },
        "action": { "const": "docker-node-disconnect" },
        "external_action_applied": { "const": true },
        "public_observation_bound": { "const": false },
        "restored": { "const": true },
        "network_id": { "$ref": "#/$defs/networkID" },
        "network_name": { "$ref": "#/$defs/networkName" },
        "container_id": { "$ref": "#/$defs/containerID" },
        "restored_ipv4": { "type": "string", "format": "ipv4" },
        "restored_aliases": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "command_exit_code": { "$ref": "#/$defs/exitCode" },
        "generated_at": { "$ref": "#/$defs/generatedAt" }
      }
    },
    "nodeRestart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "token", "action", "external_action_applied",
        "public_observation_bound", "restored", "container_id", "signal",
        "exit_code_after_kill", "started_at_before", "started_at_after",
        "command_exit_code", "generated_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "token": { "$ref": "#/$defs/token" },
        "action": { "const": "docker-node-kill-restart" },
        "external_action_applied": { "const": true },
        "public_observation_bound": { "const": false },
        "restored": { "const": true },
        "container_id": { "$ref": "#/$defs/containerID" },
        "signal": { "const": "KILL" },
        "exit_code_after_kill": { "const": 137 },
        "started_at_before": { "$ref": "#/$defs/generatedAt" },
        "started_at_after": { "$ref": "#/$defs/generatedAt" },
        "command_exit_code": { "$ref": "#/$defs/exitCode" },
        "generated_at": { "$ref": "#/$defs/generatedAt" }
      }
    }
  }
}
