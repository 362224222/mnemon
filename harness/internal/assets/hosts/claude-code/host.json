{
  "schema_version": 2,
  "name": "claude-code",
  "description": "Registers Mnemon R1 static render hooks in Claude Code.",
  "surfaces": {
    "projection": [
      ".claude/hooks/mnemon-r1",
      ".claude/settings.json"
    ],
    "observation": [
      ".mnemon/hosts/claude-code/manifest.json",
      ".mnemon/harness/local/render-audit.jsonl"
    ]
  },
  "lifecycle_mapping": {
    "prime": "SessionStart",
    "remind": "UserPromptSubmit",
    "nudge": "Stop",
    "compact": "PreCompact",
    "maintenance": "subagent-or-manual"
  },
  "mechanics": {
    "stdin_read": {
      "default": "strict"
    },
    "dialect": {
      "default": "plain"
    },
    "json_escape": true
  }
}
