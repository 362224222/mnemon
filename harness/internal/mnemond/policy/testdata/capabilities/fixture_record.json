{
  "schema_version": 1,
  "name": "fixture_record",
  "observed_type": "fixture_record.write_candidate.observed",
  "proposed_type": "fixture_record.write.proposed",
  "resource_kind": "fixture_record",
  "items_field": "entries",
  "fields": [
    {
      "name": "content",
      "validators": [
        {
          "id": "required",
          "params": {
            "missing_style": "empty"
          }
        },
        {
          "id": "safety:secret"
        },
        {
          "id": "safety:injection"
        }
      ]
    },
    {
      "name": "source",
      "validators": [
        {
          "id": "required",
          "params": {
            "missing_style": "missing"
          }
        }
      ]
    },
    {
      "name": "confidence",
      "validators": [
        {
          "id": "required",
          "params": {
            "missing_style": "missing"
          }
        }
      ]
    },
    {
      "name": "tags",
      "validators": [
        {
          "id": "list:strings"
        }
      ]
    }
  ],
  "render": {
    "content": {
      "member": "entry-list"
    }
  },
  "sync": {
    "importable": true,
    "merge": "entry-dedup"
  }
}
